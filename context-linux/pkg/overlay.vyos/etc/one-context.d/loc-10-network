#!/usr/bin/env bash

# Native VyOS network contextualization entry point.
# shellcheck disable=SC1091
. /etc/one-context.d/loc-10-network.d/functions

context_type=$1
action=${2:-configure}

# shellcheck disable=SC1091
. /etc/one-context.d/loc-10-network.d/netcfg-vyos

if ! is_network_supported; then
    echo 'ERROR [!]: Native VyOS configuration interface is unavailable' >&2
    exit 1
fi

if [ "${context_type}" = 'local' ]; then
    case "${action}" in
        configure|reconfigure) initialize_network ;;
        *)
            echo "ERROR [!]: Unknown ACTION: ${action}" >&2
            exit 1
            ;;
    esac
fi

if [ "${required_context_type:-local}" != "${context_type}" ]; then
    exit 0
fi

case "${action}" in
    configure)
        configure_network
        ;;
    reconfigure)
        configure_network
        reload_network
        ;;
    *)
        echo "ERROR [!]: Unknown ACTION: ${action}" >&2
        exit 1
        ;;
esac
