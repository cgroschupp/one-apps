#!/usr/bin/env bash

SERVICES=${SERVICES:-one-context one-context-reconfigure one-context-reconfigure-delayed}
TIMERS=${TIMERS:-one-context-reconfigure.timer}

if command -v systemctl >/dev/null 2>&1 && [ -d /etc/systemd ]; then
    for service in ${TIMERS} ${SERVICES}; do
        systemctl --no-reload disable "${service}" >/dev/null 2>&1 || :
        systemctl stop "${service}" >/dev/null 2>&1 || :
    done
fi

exit 0
