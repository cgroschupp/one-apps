# VyOS network configuration backend. Commands generated by this backend are
# tracked separately so recontextualization only removes values it previously
# created. The state is persistent because VyOS configuration is saved too.

export required_context_type='local'

VYOS_CONTEXT_STATE_DIR=${VYOS_CONTEXT_STATE_DIR:-/config/one-context}
VYOS_CONTEXT_STATE=${VYOS_CONTEXT_STATE:-${VYOS_CONTEXT_STATE_DIR}/network.commands}
VYOS_CONTEXT_PENDING=${VYOS_CONTEXT_PENDING:-/run/one-context/vyos-network.commands}

# Variables populated by the shared setup helpers.
export ip network mask cidr ip6 ip6_prefix_length ip6_ula
export mac dev mtu gateway metric dns search_domains method static_routes
export ip6_gateway ip6_metric ip6_method external detach onegate_host

is_network_supported()
{
    [ -x /bin/vbash ] && \
        [ -r /opt/vyatta/etc/functions/script-template ] && \
        command -v sg >/dev/null 2>&1
}

# The generic initializer removes Linux network configuration and sysctl
# files. VyOS owns those resources itself, so this backend only prepares its
# own state and the optional link-local OneGate route.
initialize_network()
{
    install -d -m 0700 "${VYOS_CONTEXT_STATE_DIR}" "$(dirname "${VYOS_CONTEXT_PENDING}")"
    export onegate_proxy_route_missing='yes'
    get_onegate_ip
}

vyos_valid_address()
{
    case "$1" in
        *[!0-9A-Fa-f:./]*) return 1 ;;
        *.*|*:*) return 0 ;;
        *) return 1 ;;
    esac
}

vyos_valid_ip()
{
    case "$1" in
        *[!0-9A-Fa-f:.]*) return 1 ;;
        *.*|*:*) return 0 ;;
        *) return 1 ;;
    esac
}

vyos_valid_uint()
{
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

vyos_valid_domain()
{
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
    esac
}

vyos_emit()
{
    _delete_words=$1
    shift

    printf 'delete'
    _word_number=0
    for _word in "$@"; do
        _word_number=$((_word_number + 1))
        [ "${_word_number}" -gt "${_delete_words}" ] && continue
        printf ' %s' "${_word}"
    done
    printf '\tset'
    for _word in "$@"; do
        printf ' %s' "${_word}"
    done
    printf '\n'
}

vyos_emit_address()
{
    _address=$1
    if vyos_valid_address "${_address}"; then
        vyos_emit 5 interfaces ethernet "${dev}" address "${_address}"
    else
        echo "ERROR [!]: Invalid address '${_address}' for ${dev}" >&2
        return 1
    fi
}

vyos_emit_default_route()
{
    _family=$1
    _gateway=$2
    _distance=$3

    [ -n "${_gateway}" ] || return 0
    if ! vyos_valid_ip "${_gateway}"; then
        echo "ERROR [!]: Invalid gateway '${_gateway}' for ${dev}" >&2
        return 1
    fi

    if [ "${_family}" = 'route6' ]; then
        _destination='::/0'
    else
        _destination='0.0.0.0/0'
    fi

    if [ -n "${_distance}" ]; then
        vyos_valid_uint "${_distance}" || return 1
        vyos_emit 6 protocols static "${_family}" "${_destination}" next-hop "${_gateway}" distance "${_distance}"
    else
        vyos_emit 6 protocols static "${_family}" "${_destination}" next-hop "${_gateway}"
    fi
}

vyos_emit_static_routes()
{
    [ -n "${static_routes}" ] || return 0

    _old_ifs=${IFS}
    IFS=','
    for _route in ${static_routes}; do
        IFS=' ' read -r _destination _via _gateway _rest <<EOF
${_route}
EOF
        IFS=','

        if ! vyos_valid_address "${_destination}" || ! vyos_valid_ip "${_gateway}"; then
            echo "ERROR [!]: Invalid static route '${_route}' for ${dev}" >&2
            IFS=${_old_ifs}
            return 1
        fi

        case "${_destination}${_gateway}" in
            *:*) _family='route6' ;;
            *) _family='route' ;;
        esac
        vyos_emit 6 protocols static "${_family}" "${_destination}" next-hop "${_gateway}"
    done
    IFS=${_old_ifs}
}

vyos_emit_aliases()
{
    _aliases=$(get_interface_alias "$1")
    for _nic_alias in ${_aliases}; do
        setup_ipadr_vars "${_nic_alias}"
        setup_ip6adr_vars "${_nic_alias}"
        setup_alias_vars "${_nic_alias}"

        if [ -z "${detach}" ] && ! is_true "${external}"; then
            [ -z "${ip}" ] || vyos_emit_address "${ip}/$(mask2cidr "${mask}")" || return 1
            [ -z "${ip6}" ] || vyos_emit_address "${ip6}/${ip6_prefix_length:-64}" || return 1
        fi
    done
}

vyos_emit_interface()
{
    _iface=$1
    setup_iface_vars "${_iface}"

    if [ -z "${dev}" ]; then
        echo "ERROR [!]: No device matches ${_iface}_MAC=${mac}" >&2
        return 1
    fi
    case "${dev}" in
        *[!A-Za-z0-9_.:-]*)
            echo "ERROR [!]: Invalid device name '${dev}'" >&2
            return 1
            ;;
    esac

    if [ "${method}" = 'skip' ] && [ "${ip6_method}" = 'skip' ]; then
        return 0
    fi

    if [ -n "${mtu}" ]; then
        if vyos_valid_uint "${mtu}"; then
            vyos_emit 4 interfaces ethernet "${dev}" mtu "${mtu}"
        else
            echo "ERROR [!]: Invalid MTU '${mtu}' for ${dev}" >&2
            return 1
        fi
    fi

    case "${method}" in
        ''|static)
            [ -z "${ip}" ] || vyos_emit_address "${ip}/${cidr}" || return 1
            vyos_emit_default_route route "${gateway}" "${metric}" || return 1
            vyos_emit_static_routes || return 1
            ;;
        dhcp)
            vyos_emit 5 interfaces ethernet "${dev}" address dhcp
            ;;
        skip)
            ;;
        *)
            echo "ERROR [!]: Unknown IPv4 method '${method}' for ${dev}" >&2
            return 1
            ;;
    esac

    case "${ip6_method}" in
        ''|static)
            [ -z "${ip6}" ] || vyos_emit_address "${ip6}/${ip6_prefix_length:-64}" || return 1
            [ -z "${ip6_ula}" ] || vyos_emit_address "${ip6_ula}/64" || return 1
            vyos_emit_default_route route6 "${ip6_gateway}" "${ip6_metric}" || return 1
            ;;
        auto)
            vyos_emit 6 interfaces ethernet "${dev}" ipv6 address autoconf
            ;;
        dhcp)
            vyos_emit 5 interfaces ethernet "${dev}" address dhcpv6
            ;;
        disable)
            vyos_emit 6 interfaces ethernet "${dev}" ipv6 address no-default-link-local
            ;;
        skip)
            ;;
        *)
            echo "ERROR [!]: Unknown IPv6 method '${ip6_method}' for ${dev}" >&2
            return 1
            ;;
    esac

    vyos_emit_aliases "${_iface}" || return 1

    if missing_onegate_proxy_route && vyos_valid_ip "${onegate_host}"; then
        vyos_emit 6 protocols static route "${onegate_host}/32" interface "${dev}"
        unset onegate_proxy_route_missing
    fi
}

vyos_emit_dns()
{
    for _nameserver in $(get_nameservers); do
        if vyos_valid_ip "${_nameserver}"; then
            vyos_emit 3 system name-server "${_nameserver}"
        else
            echo "ERROR [!]: Invalid DNS server '${_nameserver}'" >&2
            return 1
        fi
    done

    for _domain in $(get_searchdomains); do
        if vyos_valid_domain "${_domain}"; then
            vyos_emit 3 system domain-search "${_domain}"
        else
            echo "ERROR [!]: Invalid search domain '${_domain}'" >&2
            return 1
        fi
    done
}

vyos_emit_hostname()
{
    [ -n "${SET_HOSTNAME}" ] || return 0
    _hostname=$(printf '%s' "${SET_HOSTNAME%%.*}" | sed -e 's/[^-A-Za-z0-9]/-/g' -e 's/^-*//' -e 's/-*$//')
    [ -z "${_hostname}" ] || vyos_emit 2 system host-name "${_hostname}"

    _domain=${SET_HOSTNAME#*.}
    if [ "${_domain}" != "${SET_HOSTNAME}" ] && vyos_valid_domain "${_domain}"; then
        vyos_emit 2 system domain-name "${_domain}"
    fi
}

gen_network_configuration()
{
    for _iface in $(get_context_interfaces); do
        vyos_emit_interface "${_iface}" || return 1
    done
    vyos_emit_dns || return 1
    vyos_emit_hostname
}

vyos_apply_configuration()
{
    _desired=$1
    _script=$(mktemp "$(dirname "${VYOS_CONTEXT_PENDING}")/vyos-config.XXXXXX")
    {
        echo '#!/bin/vbash'
        echo 'source /opt/vyatta/etc/functions/script-template'
        echo 'configure'
        if [ -s "${VYOS_CONTEXT_STATE}" ]; then
            cut -f1 "${VYOS_CONTEXT_STATE}" | sed -e 's/$/ || true/'
        fi
        cut -f2 "${_desired}" | sed -e 's/$/ || exit 1/'
        echo "commit comment 'OpenNebula context network' || exit 1"
        echo 'save || exit 1'
        echo 'exit'
    } >"${_script}"
    chmod 0700 "${_script}"

    if sg vyattacfg -c "${_script}"; then
        install -m 0600 "${_desired}" "${VYOS_CONTEXT_STATE}"
        rm -f "${_script}"
        return 0
    fi

    rm -f "${_script}"
    return 1
}

configure_network()
{
    install -d -m 0700 "${VYOS_CONTEXT_STATE_DIR}" "$(dirname "${VYOS_CONTEXT_PENDING}")"
    _raw_tmp=$(mktemp "${VYOS_CONTEXT_PENDING}.raw.XXXXXX")
    _pending_tmp=$(mktemp "${VYOS_CONTEXT_PENDING}.XXXXXX")
    if ! gen_network_configuration >"${_raw_tmp}"; then
        rm -f "${_raw_tmp}" "${_pending_tmp}"
        return 1
    fi
    awk '!seen[$0]++' "${_raw_tmp}" >"${_pending_tmp}"
    rm -f "${_raw_tmp}"
    chmod 0600 "${_pending_tmp}"
    mv -f "${_pending_tmp}" "${VYOS_CONTEXT_PENDING}"

    if [ -f "${VYOS_CONTEXT_STATE}" ] && cmp -s "${VYOS_CONTEXT_PENDING}" "${VYOS_CONTEXT_STATE}"; then
        return 0
    fi

    vyos_apply_configuration "${VYOS_CONTEXT_PENDING}"
}

stop_network()
{
    :
}

start_network()
{
    :
}

reload_network()
{
    :
}
